def validar_login(usuario, senha):
    usuarios = {
        "admin": "1234",
        "joao": "abcd",
        "maria": "5678"
    }

    if usuario in usuarios and usuarios[usuario] == senha:
        print("Login realizado com sucesso!")
    else:
        print("Usuário ou senha incorretos!")

# Teste
validar_login("admin", "1234")